;;; public-api-test.el --- Exact restore API checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-claude)

(ert-deftest emacs-claude-public-creation-always-uses-a-fresh-id-without-a-picker ()
  (let ((root (make-temp-file "claude-create-api-" t))
        (buffer (generate-new-buffer " *claude create api*")) (counter 0) ids)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-claude--uuid) (lambda () (format "new-%s" (cl-incf counter))))
                  ((symbol-function 'emacs-claude--open) (lambda (id _) (push id ids) buffer))
                  ((symbol-function 'emacs-claude--pick) (lambda (&rest _) (ert-fail "Unexpected picker")))
                  ((symbol-function 'emacs-claude-send) (lambda (&rest _) (ert-fail "Unexpected user prompt")))
                  ((symbol-function 'emacs-claude--show) (lambda (_) (ert-fail "Display must be suppressed"))))
          (dotimes (_ 2) (should (eq (emacs-claude-create-session root :display nil) buffer)))
          (should (equal ids '("new-2" "new-1"))))
      (kill-buffer buffer) (delete-directory root t))))

(ert-deftest emacs-claude-public-restore-refuses-missing-history-and-invalid-id ()
  (let* ((root (make-temp-file "claude-api-" t))
         (emacs-claude-config-directory root)
         (emacs-claude-directory (expand-file-name "state" root)))
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-claude--open) (lambda (&rest _) (ert-fail "Unexpected launch"))))
          (should-error (emacs-claude-open-session "saved-id" :directory root :display nil) :type 'user-error)
          (should-error (emacs-claude-open-session "../escape" :directory root :display nil) :type 'user-error))
      (delete-directory root t))))

(ert-deftest emacs-claude-public-restore-preserves-exact-id-and-display-policy ()
  (let* ((root (make-temp-file "claude-api-" t)) (buffer (generate-new-buffer " *claude api*")) seen shown)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-claude-session-running-p) (lambda (_) t))
                  ((symbol-function 'emacs-claude--open) (lambda (id directory) (setq seen (list id directory)) buffer))
                  ((symbol-function 'emacs-claude--show) (lambda (_) (setq shown t))))
          (should (eq (emacs-claude-open-session "exact-id" :directory root :display nil) buffer))
          (should (equal seen (list "exact-id" (file-name-as-directory (file-truename root)))))
          (should-not shown)
          (emacs-claude-open-session "exact-id" :directory root)
          (should shown))
      (kill-buffer buffer) (delete-directory root t))))

(ert-deftest emacs-claude-holder-uses-the-configured-history-home ()
  (let* ((root (make-temp-file "claude-api-home-" t))
         (emacs-claude-directory (expand-file-name "state/" root))
         (emacs-claude-config-directory (expand-file-name "selected-home" root))
         (emacs-claude-executable (executable-find "true"))
         (emacs-claude-extra-arguments nil)
         (process-environment (copy-sequence process-environment)) seen)
    (setenv "CLAUDE_CONFIG_DIR" "/wrong/inherited-home")
    (unwind-protect
        (cl-letf (((symbol-function 'call-process)
                   (lambda (program &rest _)
                     (when (equal program "nohup") (setq seen (getenv "CLAUDE_CONFIG_DIR")))
                     0)))
          (emacs-claude--start-holder "saved-id" root)
          (should (equal seen (expand-file-name emacs-claude-config-directory)))
          (should (equal (getenv "CLAUDE_CONFIG_DIR") "/wrong/inherited-home")))
      (delete-directory root t))))

(provide 'public-api-test)
